# API Express
PORT=3000
MONGO_URI=mongodb://localhost:27017/meditrack
# Obligatoire, 32 caractères minimum : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Tentatives autorisées sur /api/auth par IP et par fenêtre de 15 min
AUTH_RATE_LIMIT=10
FRONTEND_URL=http://localhost:4200

# Connexion en 2 étapes : code à 6 chiffres envoyé par email (false pour la désactiver en dev)
TWO_FACTOR_ENABLED=true
# SMTP pour l'envoi des emails. Vide = emails affichés dans la console de l'API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MediTrack <no-reply@meditrack.ma>

# Admin créé par le script de seed : cd backend && npm run seed
ADMIN_EMAIL=admin@meditrack.local
ADMIN_PASSWORD=
# Optionnel : mot de passe commun des médecins de démo (sinon généré et affiché par le seed)
SEED_DOCTOR_PASSWORD=
